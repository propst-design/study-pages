// Cloudflare Workers Builds config for the live site (https://study-pages.jacobt666.workers.dev).
// The site is plain static files: everything in study-pages/ is served from the site root.
// The only server code is worker/index.js, which answers /api/* (username + PIN sync) and nothing else.
{
  "name": "study-pages",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./study-pages", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // Sync storage. No database_id on purpose: the first `wrangler deploy` creates the database
  // (named study-pages-db) and later deploys keep using it. The worker creates its own tables.
  "d1_databases": [{ "binding": "DB" }],
  // Needed by `npx wrangler preview`, which Cloudflare runs for pull-request builds.
  "previews": {}
}
